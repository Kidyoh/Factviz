# Copy to .env (never commit it) and fill in. The server reads these from
# the process environment, e.g. `set -a; source .env; set +a`.

# OpenRouter API key (https://openrouter.ai/keys). Required.
OPENROUTER_API_KEY=

# Provider: "openrouter" (default) or "openai_compatible" with LLM_BASE_URL.
LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Model for both layers. Any OpenRouter model id that supports structured outputs.
LLM_MODEL=google/gemini-3.8-flash
# Optional per-layer overrides:
# LLM_FACTS_MODEL=google/gemini-3.1-pro-preview
# LLM_PLANNER_MODEL=google/gemini-3.5-flash-lite

# Shown in OpenRouter's dashboard for attribution (optional).
# APP_URL=https://example.com
APP_TITLE=Explain It Visually

PORT=8080
LLM_TIMEOUT_SECONDS=60
# Requests per minute per client IP on /api routes (0 = off).
RATE_LIMIT_PER_MINUTE=20
# Set to true behind a load balancer that sets X-Forwarded-For (e.g. Cloud Run).
TRUST_PROXY=false
